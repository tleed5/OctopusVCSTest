name = "DrawerAddEditTesting"
description = ""

parameter "MyParameter" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = "heehee hoohoo"
    is_optional = true
    label = "This is a parameter"

    value "Default" {}
}

parameter "Sensitive" {
    display_settings = {
        Octopus.ControlType = "Sensitive"
    }
    help_text = ""
    is_optional = true
    label = ""

    value "9ba6f91b-66dd-4ee9-bf14-9a5cae0528e4" {}
}

parameter "DropDown" {
    display_settings = {
        Octopus.ControlType = "Select"
        Octopus.SelectOptions = <<-EOT
            val1|Value 1
            val2|Value 2
            val3|Value 3
            EOT
    }
    help_text = ""
    label = ""

    value "val1" {}
}

parameter "fadfasd" {
    display_settings = {
        Octopus.ControlType = "TargetTags"
    }
    help_text = ""
    label = ""
}

parameter "ThisShouldntExisttt" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = ""
    label = ""
}

parameter "dwadwadsd" {
    display_settings = {
        Octopus.ControlType = "Package"
    }
    help_text = ""
    label = ""
}

parameter "CertificateParam" {
    display_settings = {
        Octopus.ControlType = "Certificate"
    }
    help_text = ""
    label = ""
}

step "run-a-script" {
    name = "Run a Script"
    properties = {
        Octopus.Action.TargetRoles = "#{fadfasd}"
    }

    action {
        action_type = "Octopus.Script"
        properties = {
            Octopus.Action.RunOnServer = "false"
            Octopus.Action.Script.ScriptFileName = "script"
            Octopus.Action.Script.ScriptSource = "Package"
        }
        worker_pool_variable = ""

        packages {
            acquisition_location = "Server"
            feed = "octopus-server-built-in"
            package_id = ""
            properties = {
                PackageParameterName = "dwadwadsd"
                SelectionMode = "deferred"
            }
        }
    }
}

step "configure-and-apply-a-kubernetes-ingress" {
    name = "Configure and apply a Kubernetes Ingress"
    properties = {
        Octopus.Action.TargetRoles = "#{fadfasd}"
    }

    action {
        action_type = "Octopus.KubernetesDeployIngress"
        properties = {
            Octopus.Action.Kubernetes.DeploymentTimeout = "180"
            Octopus.Action.Kubernetes.ResourceStatusCheck = "True"
            Octopus.Action.Kubernetes.ServerSideApply.Enabled = "True"
            Octopus.Action.Kubernetes.ServerSideApply.ForceConflicts = "True"
            Octopus.Action.KubernetesContainers.DefaultRulePort = "123"
            Octopus.Action.KubernetesContainers.DefaultRuleServiceName = "3dafdsfasdf"
            Octopus.Action.KubernetesContainers.IngressAnnotations = "[]"
            Octopus.Action.KubernetesContainers.IngressName = "sdasd"
        }
        worker_pool_variable = ""
    }
}