step "commit-to-git" {
    condition = "Variable"
    name = "Commit to Git"
    properties = {
        Octopus.Step.ConditionVariableExpression = "#{if Octopus.Environment.Name == \"Development\"}true#{/if}"
    }

    action {
        action_type = "Octopus.CommitToGit"
        properties = {
            Octopus.Action.Git.CommitMessageDescription = <<-EOT
                Project: #{Octopus.Project.Slug}
                Environment: #{Octopus.Environment.Slug}#{if Octopus.Deployment.Tenant.Slug }
                Tenant: #{Octopus.Deployment.Tenant.Slug}#{/if}
                EOT
            Octopus.Action.Git.CommitMessageSummary = "Updated files with Release: #{Octopus.Release.Number}"
            Octopus.Action.Git.CommitMethod = "PullRequest"
            Octopus.Action.Git.InputFileSources = "[{\"Type\":\"GitRepository\",\"DestinationSubfolder\":\"\",\"InputFilePaths\":[\"Templates/*\"],\"GitDependencyName\":\"InputGit-1\"}]"
            Octopus.Action.Git.PushRetryAttempts = "2"
            Octopus.Action.Git.StepVerification.Method = "CommitCreated"
            Octopus.Action.Git.StepVerification.Timeout = "180"
            Octopus.Action.Git.TargetRepositoryBranch = "main"
            Octopus.Action.Git.TargetRepositoryCredentialId = "GitCredentials-121"
            Octopus.Action.Git.TargetRepositoryCredentialType = "Library"
            Octopus.Action.Git.TargetRepositoryDestinationPath = "ArgoCD/Applications"
            Octopus.Action.Git.TargetRepositoryUrl = "#{GitRepo}"
            Octopus.Action.Script.ScriptBody = "echo 'foo'"
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
        }

        git_dependencies "InputGit-1" {
            default_branch = "main"
            file_path_filters = ["Templates/*"]
            git_credential_id = "GitCredentials-121"
            git_credential_type = "Library"
            repository_uri = "https://github.com/tleed5/OctopusVCSTest.git"
        }
    }
}