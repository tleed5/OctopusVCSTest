step "echo" {
    name = "Echo"
    properties = {
        Octopus.Action.TargetRoles = "agent"
    }

    action {
        properties = {
            Message = "Woooo"
            Octopus.Action.RunOnServer = "false"
            Octopus.Action.Template.Id = "ActionTemplates-25"
            Octopus.Action.Template.Version = "0"
        }
        worker_pool_variable = ""
    }
}

process_template "run-a-process-template" {
    name = "Run a Process Template"
    process_template_slug = "process"
    version_mask = "2.X"

    package_parameter "Container" {
        feed = "docker"
        package_id = "nginx"
    }

    parameter "ReplacePath" {
        value = "erdfasdfadsf"
    }

    parameter "Targets" {
        value = "agent"
    }
}

step "slack-send-simple-notification" {
    name = "Slack - Send Simple Notification"
    properties = {
        Octopus.Action.TargetRoles = "agent"
    }

    action {
        properties = {
            Octopus.Action.RunOnServer = "false"
            Octopus.Action.Template.Id = "ActionTemplates-26"
            Octopus.Action.Template.Version = "15"
            ssn_Channel = "fadsfsdafadsf"
            ssn_Color = "good"
            ssn_HookUrl = "#{Octopus.Account.AccountType}"
            ssn_IconUrl = "https://octopus.com/content/resources/favicon.png"
            ssn_Message = "fadfdasf"
            ssn_Title = "fasdfasdf"
            ssn_Username = "Octopus Deploy"
        }
        worker_pool_variable = ""
    }
}

step "run-a-script" {
    name = "Run a Script"

    action {
        action_type = "Octopus.Script"
        properties = {
            Octopus.Action.RunOnServer = "true"
            Octopus.Action.Script.ScriptBody = "echo 'foobar'"
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
            OctopusUseBundledTooling = "False"
        }
    }
}